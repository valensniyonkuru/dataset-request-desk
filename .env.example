# Environment variables for the app. Copy to .env and change every value.
# On the server this file lives at /opt/dataset-request-desk/.env.
# Never commit a real .env.

# Used by the postgres container to create the database on first start.
POSTGRES_USER=desk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=desk

# Used by the api. "db" is the database service name on the compose network.
DATABASE_URL=postgresql+psycopg://desk:change-me@db:5432/desk
SECRET_KEY=change-me-to-a-long-random-string
ENV=production

# Optional. Folder containing users.json for `python -m app.seed`.
# Defaults to /app/seed, where the backend image puts the repo's seed/ folder.
# SEED_DIR=/app/seed
